# EstateArms Scanner — environment variables
# Copy this to .env and fill in the keys you have. The scanner will run without
# any keys (stub mode), so you can test the UI and inventory pipeline first.

# Vision provider selection: "auto" (prefer anthropic, else openai, else stub),
# "anthropic", or "openai".
VISION_PROVIDER=auto

# Primary: Claude vision for firearm ID + variant reasoning.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Alternate: OpenAI vision. Only used if VISION_PROVIDER=openai or no Anthropic key.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-2024-11-20

# Serial + proof mark OCR via Google Cloud Vision REST API.
# Get a key at https://console.cloud.google.com/apis/credentials with the Vision API enabled.
# GOOGLE_CLOUD_VISION_API_KEY=AIza...
